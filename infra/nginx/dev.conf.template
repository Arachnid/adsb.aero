proxy_cache_path /var/cache/nginx/openaip
    levels=1:2
    keys_zone=openaip:4m
    max_size=512m
    inactive=30d
    use_temp_path=off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;
    resolver 127.0.0.11 valid=30s;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml application/x-protobuf application/vnd.mapbox-vector-tile;
    gzip_proxied any;
    gzip_vary on;
    gzip_min_length 256;

    # OpenAIP chart tile proxy (dev — allows localhost referers).
    location ~ ^/tiles/openaip/(?<tile_path>.+)$ {
        valid_referers blocked server_names "~localhost" "~adsb\.aero";
        if ($invalid_referer) {
            return 403;
        }

        proxy_cache            openaip;
        proxy_cache_key        $uri;
        proxy_cache_valid      200 7d;
        proxy_cache_valid      404 1m;
        proxy_cache_use_stale  error timeout updating;
        proxy_cache_lock       on;
        proxy_cache_lock_timeout 5s;
        proxy_ignore_headers   Cache-Control Expires;

        add_header X-Cache-Status $upstream_cache_status always;

        proxy_pass https://api.tiles.openaip.net/api/data/openaip/$tile_path?apiKey=${OPENAIP_API_KEY};
        proxy_http_version 1.1;
        proxy_ssl_server_name  on;

        proxy_set_header Host            api.tiles.openaip.net;
        proxy_set_header X-Real-IP       "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Cookie          "";
    }

    # API — preserve the full /api/... path (FastAPI routes include the /api prefix)
    location /api/ {
        set $api http://api:8000;
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }

    # Everything else → Vite dev server, including HMR WebSocket upgrades
    location / {
        set $vite http://vite:5173;
        proxy_pass $vite;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }
}
